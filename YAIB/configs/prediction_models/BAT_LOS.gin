#include "configs/prediction_models/common/DLCommon.gin"
include "configs/prediction_models/common/DLCommon_nodsa.gin"

# Dataloader
BATPolarsDataset.runmode = "regression"

# Train params
train_common.model = @BAT
train_common.dataset_class = @BATPolarsDataset
train_common.verbose = True
train_common.cpu = True

# Optimizer params
optimizer/hyperparameter.class_to_tune = @Adam
optimizer/hyperparameter.weight_decay = 1e-6
optimizer/hyperparameter.lr = 1e-4

# Encoder params - fixed to match the pretrained checkpoint exactly
model/hyperparameter.class_to_tune = @BAT
model/hyperparameter.value_embed_size = 128
model/hyperparameter.layers = 2
model/hyperparameter.heads = 1
model/hyperparameter.dropout = 0.36427
model/hyperparameter.attn_dropout = 0.20659
model/hyperparameter.use_mask = False
model/hyperparameter.prediction_head = @icu_benchmarks.models.dl_models.bat.RegressionHead
model/hyperparameter.prediction_head_kwargs = {"output_dim": 1}

# Small debug run just to generate YAIB's folder structure
train_common.epochs = 2
train_common.batch_size = 32
train_common.patience = 5
train_common.min_delta = 1e-4

# CV params
execute_repeated_cv.cv_repetitions = 1
execute_repeated_cv.cv_folds = 5